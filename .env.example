# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8080"]

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amrutam_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-to-256-bit-random-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MFA ─────────────────────────────────────────────────────────────────────
MFA_ISSUER_NAME=Amrutam Pharmaceuticals

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Observability ───────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
ENABLE_METRICS=true

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ─── Payment Gateway ─────────────────────────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=change-this-webhook-hmac-secret

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@amrutam.com
SMTP_PASSWORD=smtp-password-here
